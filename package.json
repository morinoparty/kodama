{
    "name": "kodama-workspace",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.33.3",
    "scripts": {
        "dev": "pnpm --filter @kodama/app dev",
        "dev:storybook": "pnpm --filter @kodama/storybook dev",
        "build": "pnpm --filter @kodama/app build",
        "build:storybook": "pnpm --filter @kodama/storybook build",
        "build:all": "pnpm run build && pnpm run build:storybook",
        "deploy": "pnpm --filter @kodama/app run deploy",
        "deploy:storybook": "pnpm --filter @kodama/storybook run deploy",
        "generate-routes": "pnpm --filter @kodama/app generate-routes",
        "cf-typegen": "pnpm --filter @kodama/app cf-typegen",
        "panda:codegen": "pnpm -r panda:codegen",
        "check": "biome check ./ --write",
        "check:ci": "biome ci ./",
        "typecheck": "pnpm -r typecheck"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.9"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "lightningcss",
            "sharp",
            "workerd"
        ]
    }
}
