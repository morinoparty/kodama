{
    "name": "kodama-workspace",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.14.0",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "pnpm --filter @kodama/app dev",
        "dev:storybook": "pnpm --filter @kodama/storybook dev",
        "build": "pnpm run build:storybook && pnpm --filter @kodama/app build",
        "build:storybook": "pnpm --filter @kodama/storybook build",
        "deploy": "pnpm run build:storybook && pnpm --filter @kodama/app run deploy",
        "generate-routes": "pnpm --filter @kodama/app generate-routes",
        "cf-typegen": "pnpm --filter @kodama/app cf-typegen",
        "panda:codegen": "pnpm -r panda:codegen",
        "check": "biome check ./ --write",
        "check:ci": "biome ci ./",
        "typecheck": "pnpm run cf-typegen && pnpm -r typecheck"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.9"
    }
}
