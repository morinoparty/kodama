# app の .env の雛形。値を埋めて app/.env として置く (.env は git に入れない)。
# GitHub Actions には `gh secret set -f app/.env` でまとめて登録できる。
# cf は実行したディレクトリの .env だけを読むため、app/ と storybook/ に別々に置く。

# --- cf CLI (deploy) 用。Worker には渡さない ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Worker secret。cf dev はここから読み、deploy 時は --secrets-file で渡す ---
# Better Auth の署名鍵 (例: openssl rand -base64 32)
AUTH_SECRET=
# MineAuth のサービスアカウント トークン。プラグイン一覧 (MPM) の API で使う
MINEAUTH_SERVICE_TOKEN=

# --- 任意 ---
# CLIENT_ID / MAIN_SERVER_URL / SERVER_URL / SERVERS は cloudflare.config.ts の
# env に定義済みなので、ローカルで別の値を使いたいときだけ上書きすること。
# MAIN_SERVER_URL=https://api.morino.party/main
# SERVER_URL=https://api.morino.party/
# SERVERS=main,res,lobby
# CLIENT_ID=

